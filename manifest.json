{
  "manifest_version": 3,
  "key": "",
  "name": "Bookmark Divider",
  "version": "2.0",
  "description": "Adds divider lines to the bookmarks bar. Drag them between bookmarks to make groups.",
  "permissions": ["bookmarks"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Add a divider to the bookmarks bar",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
